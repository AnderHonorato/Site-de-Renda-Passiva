# .env.exemplo — copie para .env e ajuste. Nunca suba o .env para o git.

# Porta inicial. Se estiver ocupada, o servidor tenta a próxima até PORTA_FINAL.
PORTA=4870
PORTA_FINAL=4889

# desenvolvimento | producao (em producao o cookie de sessão exige HTTPS)
AMBIENTE=desenvolvimento

# Ligue só se o site estiver atrás de um proxy confiável (Nginx, Cloudflare). Padrão: desligado.
TRUST_PROXY=false

# Caminho do arquivo do banco SQLite (relativo à pasta do projeto)
BANCO_CAMINHO=banco/dados/ander-flow.sqlite

# Dias de validade da sessão
SESSAO_DIAS=30

# Endereço público usado nos links dos e-mails
URL_PUBLICA=http://localhost:4870

# arquivo = grava os e-mails em .execucao/emails/ (não há envio real integrado)
EMAIL_MODO=arquivo

# erro | aviso | info | depuracao
LOG_NIVEL=info
