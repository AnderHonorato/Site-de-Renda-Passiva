{
  "name": "portal-de-ferramentas",
  "private": true,
  "version": "1.3.5",
  "description": "Portal de ferramentas com conta opcional, chat moderado e publicidade condicional.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": { "node": ">=22.14" },
  "scripts": {
    "gerar": "node --env-file-if-exists=.env ferramentas/gerar.mjs",
    "verificar": "node ferramentas/verificar.mjs",
    "testar": "node --test \"testes/*.test.mjs\"",
    "testar:navegador": "node --test --test-concurrency=1 testes/navegador/*.teste.mjs",
    "no-ar": "node ferramentas/manter-no-ar.mjs --porta 4400",
    "servir": "node ferramentas/servir.mjs . --porta 4400",
    "api": "node --env-file-if-exists=.env servidor/iniciar.mjs",
    "dev": "node --env-file-if-exists=.env ferramentas/desenvolver.mjs",
    "testar:api": "node --test --test-concurrency=1 testes/api/*.test.mjs",
    "admin:criar": "node --env-file-if-exists=.env scripts-admin/conceder-admin.mjs",
    "admin:recuperar": "node --env-file-if-exists=.env scripts-admin/gerar-link-recuperacao.mjs",
    "publicar": "node ferramentas/publicar.mjs",
    "construir": "npm run conferir && npm run publicar",
    "conferir": "npm run gerar && npm run testar && npm run verificar",
    "medir": "node ferramentas/medir-desempenho.mjs",
    "vitrine:capas": "node vitrine/ferramentas/vitrine-gerar-capas.mjs",
    "vitrine:video": "node vitrine/ferramentas/vitrine-renderizar-video.mjs"
  }
}
