{
  "name": "portal-de-ferramentas",
  "private": true,
  "version": "1.0.0",
  "description": "Portal único de ferramentas do Ander: site estático, sem servidor e sem cadastro.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": { "node": ">=20" },
  "scripts": {
    "gerar": "node ferramentas/gerar.mjs",
    "verificar": "node ferramentas/verificar.mjs",
    "testar": "node --test \"testes/*.test.mjs\"",
    "testar:navegador": "node --test testes/navegador/*.teste.mjs",
    "servir": "node ferramentas/servir.mjs . --porta 4400",
    "publicar": "node ferramentas/publicar.mjs",
    "construir": "npm run conferir && npm run publicar",
    "conferir": "npm run gerar && npm run testar && npm run verificar",
    "vitrine:capas": "node vitrine/ferramentas/vitrine-gerar-capas.mjs",
    "vitrine:video": "node vitrine/ferramentas/vitrine-renderizar-video.mjs"
  }
}
