generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id            String      @id @default(cuid())
  nome          String?
  email         String?     @unique
  imagem        String?
  criadoEm      DateTime    @default(now())
  atualizadoEm  DateTime    @updatedAt
  contas        ContaOAuth[]
  sessoes       Sessao[]
  recentes      FerramentaRecente[]
  downloads     Download[]
  preferencias  Preferencia[]
}

model ContaOAuth {
  id                String   @id @default(cuid())
  usuarioId         String
  provedor          String
  idNoProvedor      String
  accessToken       String?  @db.Text
  refreshToken      String?  @db.Text
  expiraEm          Int?
  escopo            String?
  usuario           Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([provedor, idNoProvedor])
  @@index([usuarioId])
}

model Sessao {
  id          String   @id @default(cuid())
  token       String   @unique
  usuarioId   String
  expiraEm    DateTime
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

model FerramentaRecente {
  id            String   @id @default(cuid())
  usuarioId     String
  ferramentaId  String
  vistaEm       DateTime @default(now())
  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, ferramentaId])
  @@index([usuarioId, vistaEm])
}

model Download {
  id             String   @id @default(cuid())
  usuarioId      String
  ferramentaId   String
  nomeArquivo    String
  tipoArquivo    String?
  tamanhoBytes   Int?
  referencia     String?
  baixadoEm      DateTime @default(now())
  usuario        Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, baixadoEm])
}

model Preferencia {
  id          String   @id @default(cuid())
  usuarioId   String
  chave       String
  valor       Json
  atualizadoEm DateTime @updatedAt
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, chave])
}
